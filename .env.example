# RPC endpoints. Use separate shells or keys when broadcasting on different chains.
RPC_URL=
ORIGIN_RPC_URL=
REACTIVE_RPC_URL=

# Development-only deployer key. Never use or commit a funded production key.
PRIVATE_KEY=

# Existing Uniswap v4 PoolManager and configured market currencies.
POOL_MANAGER=
BASE_CURRENCY=
BASE_DECIMALS=18
QUOTE_CURRENCY=
QUOTE_DECIMALS=18

# Provisional surcharge in basis points (maximum 1000).
SURCHARGE_BPS=50

# Reactive destination authentication. Confirm both addresses against current official network configuration.
REACTIVE_CALLBACK_PROXY=
REACTIVE_IDENTITY=

# Reactive scheduler deployment.
REACTIVE_SERVICE=
REACTIVE_CHAIN_ID=
ORIGIN_CHAIN_ID=
DESTINATION_CHAIN_ID=
REFERENCE_CHAIN_ID=
MARKOUT_HOOK=
MARKOUT_SETTLEMENT_ADAPTER=
REFERENCE_FEED=

# bytes32 identifier used by the normalized reference feed, for example keccak256("ETH/USD").
MARKET_ID=

# uint256 topic selector for the selected Reactive cron interval.
REACTIVE_CRON_TOPIC=
